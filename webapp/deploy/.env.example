# Copy to .env (gitignored) and fill in before `docker compose up`.
# docker-compose.yml reads this same file twice: once itself, for the
# ${VAR} host-port/path substitutions below, and once via the backend
# service's `env_file:`, which hands these to app/auth.py + app/db.py as
# real process env vars.

# ---- Backend: app/auth.py ----
# Signing secret for login tokens. Leave BLANK (recommended, and this
# deploy's default): the backend falls back to a file-based secret written
# into the diagen-data volume (data/secret.key) on first run, same as the
# bash-watchdog deploy — it persists across `docker compose down && up`
# same as projects.db. Only set this if you want the secret to live in the
# environment instead of the volume. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET_KEY=

# ---- Backend: app/main.py (seed accounts, created on startup if missing) ----
SEED_USERS=1
SEED_USER_PASSWORD=change-me-before-real-use

# ---- Backend: app/main.py (CORS) ----
# Leave blank — the default, and correct for this deploy. Caddy is the only
# thing the browser talks to (same-origin); it forwards to the backend
# server-side, so no real cross-origin request ever reaches here. Only used
# for comma-separated origins, if this is ever split into a cross-origin setup.
FRONTEND_ORIGIN=

# ---- Backend: app/db.py (Postgres path — unused, SQLite is the default) ----
# Documented for completeness only; this deploy's Caddyfile/compose never
# need these set — kept as an optional escape hatch if this ever points at
# a Postgres database instead of SQLite (see app/db.py's module docstring).
# INSTANCE_CONNECTION_NAME specifically is a GCP Cloud SQL mechanism with
# no use outside GCP; listed here only because the code still reads it.
DATABASE_URL=
INSTANCE_CONNECTION_NAME=
DB_NAME=diagen
DB_USER=diagen
DB_PASS=

# ---- backup service ----
BACKUP_RETAIN_DAYS=14
BACKUP_INTERVAL_SEC=21600

# ---- tunnel service: existing named Cloudflare tunnel "diagen" ----
# Already bound to dev-ai.site + drawgen.dev-ai.site — do NOT run
# `cloudflared tunnel create`, this just points at what already exists.
# Absolute host paths to the two files `cloudflared tunnel login` /
# `tunnel create` already wrote on this machine. Compose bind-mounts both
# read-only; nothing here is a secret value itself, just a path to one, but
# .env itself still stays gitignored since the paths alone are enough for
# anyone with filesystem access to this machine.
CLOUDFLARED_CERT_PATH=/absolute/path/to/.cloudflared/cert.pem
CLOUDFLARED_CREDENTIALS_PATH=/absolute/path/to/.cloudflared/<tunnel-id>.json

# ---- local host port mapping ----
# Defaults deliberately avoid 8000/8080 — the live bash-watchdog stack's
# ports — so this stack can be brought up side-by-side on the same machine
# for testing without a conflict. Neither port is needed by `tunnel` or by
# container-to-container traffic (Caddy reaches `backend`, cloudflared
# reaches `caddy`, both by service name over the compose network) — these
# only matter if you want to curl/browse the containers directly from the
# host. Safe to point these back at 8000/8080 for a real cutover, or drop
# the `ports:` lines in docker-compose.yml entirely once cloudflared is the
# only ingress you use.
BACKEND_HOST_PORT=8001
CADDY_HTTP_PORT=8081

# ---- docs site (Phase 3, built separately) ----
# Docusaurus build output directory, served under /docs/*. Fine to leave at
# the default even before it exists — see docker-compose.yml's `caddy`
# service comment.
DOCS_SITE_BUILD_PATH=../../docs-site/build
