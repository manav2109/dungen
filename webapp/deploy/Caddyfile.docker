# Container variant of ./Caddyfile (the bash-watchdog config) — same two
# hostnames, same behavior, just container-network targets instead of
# 127.0.0.1/relative paths:
#   - reverse_proxy target is the "backend" compose service name, not 127.0.0.1
#   - frontend/portal roots are baked into this image (see frontend.Dockerfile)
#     instead of a relative "../frontend/dist"
#   - adds a /docs/* block for the Docusaurus build (bind-mounted at runtime,
#     not baked into the image, so it can be updated without a rebuild — and
#     if it's not there yet, file_server just 404s under it, same as any
#     other missing file)
{
	admin off
}

http://dev-ai.site:8080 {
	root * /srv/portal
	file_server
}

http://drawgen.dev-ai.site:8080 {
	# `handle_path /docs/*` below only matches paths that already start
	# with the literal "/docs/" — a bare "/docs" (no trailing slash, as
	# every browser address bar produces when someone just types the
	# folder name) doesn't match it at all and falls through to the SPA
	# catch-all instead, serving the main app under the /docs URL. `redir`
	# runs before `handle` in Caddy's directive order regardless of where
	# it's written, so this catches it before that fallthrough happens.
	redir /docs /docs/ permanent

	# FastAPI's auto docs/redoc/openapi routes live at the backend's own
	# root (/docs, /redoc, /openapi.json) — main.py never overrides them.
	# Forwarding /api/docs straight through (like the generic /api/*
	# block below) would hit app/main.py's auth_middleware, which 401s
	# anything under /api/* that isn't in PUBLIC_API_PATHS, before the
	# request even reaches those routes. These three `handle` blocks sit
	# above the generic one (Caddy's `handle` picks the first matching
	# block, so order here matters) and rewrite the path internally
	# before proxying, so the backend sees plain "/docs" — outside the
	# "/api/" prefix the middleware gates — rather than "/api/docs".
	handle /api/docs {
		rewrite * /docs
		reverse_proxy backend:8000
	}

	handle /api/redoc {
		rewrite * /redoc
		reverse_proxy backend:8000
	}

	handle /api/openapi.json {
		rewrite * /openapi.json
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle_path /docs/* {
		root * /srv/docs
		file_server
	}

	handle {
		root * /srv/frontend
		file_server
		try_files {path} /index.html
	}
}
